<h1><%= @product.name %></h1>

<div class="actions">
  <%= link_to "Edit", edit_product_path(@product) %> |
  <%= link_to "Back to products", products_path %>

  <br><br>

  <%= button_to "Delete", @product, 
                method: :delete, 
                data: { turbo_confirm: "Are you sure?" } %>
</div>